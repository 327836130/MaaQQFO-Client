<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <MaaDesktopBuild Condition="'$(MaaDesktopBuild)' == ''">$(MSBuildThisFileDirectory)../../../bin/AnyCPU/Release</MaaDesktopBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Controller/QqfoController.cs" Link="QqfoController.cs" />
    <Reference Include="MaaFramework.Binding" HintPath="$(MaaDesktopBuild)/MaaFramework.Binding.dll" />
    <Reference Include="MaaFramework.Binding.Native" HintPath="$(MaaDesktopBuild)/MaaFramework.Binding.Native.dll" />
  </ItemGroup>
</Project>
